{
  "ReverseProxy": {
    "Routes": {
      "identity": {
        "ClusterId": "identity",
        "Order": 1,
        "CorsPolicy": "default",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "streetcode": {
        "ClusterId": "streetcode",
        "Order": 2,
        "CorsPolicy": "default",
        "Match": { "Path": "/api/{**catch-all}" }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "identity-api": { "Address": "http://localhost:5001/" }
        }
      },
      "streetcode": {
        "Destinations": {
          "api": { "Address": "http://localhost:5000/" }
        }
      }
    }
  },
  "CORS": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ],
    "AllowedHeaders": [
      "Authorization",
      "Content-Type"
    ],
    "AllowedMethods": [
      "GET",
      "POST",
      "PUT",
      "PATCH",
      "DELETE",
      "OPTIONS"
    ]
  },
  "AllowedHosts": "*"
}
