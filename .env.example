# Database
STREETCODE_ConnectionStrings__DefaultConnection="Server=localhost;Database=StreetcodeDb;User Id=sa;Password=your_password;TrustServerCertificate=True;MultipleActiveResultSets=true"

# Blob storage encryption key (must be 32 bytes for AES-256)
STREETCODE_Blob__BlobStoreKey=your_32_character_encryption_key

# Azure Blob Storage (used only when BLOB_PROVIDER=Azure)
STREETCODE_Blob__Azure__ConnectionString=

# External services
STREETCODE_Payment__Token=your_payment_token
STREETCODE_Instagram__InstagramID=your_instagram_id
STREETCODE_Instagram__InstagramToken=your_instagram_token

# Optional initial Identity administrator (set both values to seed)
STREETCODE_Identity__Admin__Email=
STREETCODE_Identity__Admin__Password=

# Docker Compose
SA_PASSWORD=Replace_With_Strong_Password123!
DB_USER=sa
DB_NAME=StreetcodeDb
MS_SQL_DB_PORT=1433
REDIS_PORT=6379
API_PORT=5000
BLOB_PROVIDER=Azure
BLOB_CONTAINER_NAME=streetcode-blobs

# Redis (used by API inside/outside Docker)
STREETCODE_ConnectionStrings__Redis=localhost:6379
