# Database
STREETCODE_ConnectionStrings__DefaultConnection="Server=localhost;Database=StreetcodeDb;User Id=sa;Password=your_password;TrustServerCertificate=True;MultipleActiveResultSets=true"

# JWT Authentication

STREETCODE_IDENTITY_JWT_SECRET_KEY=your_secret_key_here_minimum_32_characters_long
STREETCODE_IDENTITY_GoogleAuth__ClientId=
# Blob storage encryption key (must be 32 bytes for AES-256)
STREETCODE_Blob__BlobStoreKey=your_32_character_encryption_key

# Azure Blob Storage (used only when BLOB_PROVIDER=Azure)
STREETCODE_Blob__Azure__ConnectionString=

# External services
STREETCODE_Payment__Token=your_payment_token
STREETCODE_Instagram__InstagramID=your_instagram_id
STREETCODE_Instagram__InstagramToken=your_instagram_token

# Kafka email producer
STREETCODE_EmailKafka__BootstrapServers=localhost:9092
STREETCODE_EmailKafka__Topic=email.requested.v1

# Docker Compose
SA_PASSWORD=Replace_With_Strong_Password123!
DB_USER=sa
DB_NAME=StreetcodeDb
MS_SQL_DB_PORT=1433
REDIS_PORT=6379
API_PORT=5000

EMAIL_API_PORT=8081
EMAIL_DB_NAME=StreetcodeEmail
MAILPIT_UI_PORT=8025

EMAIL_SMTP_HOST=mailpit
EMAIL_SMTP_PORT=1025
EMAIL_SMTP_USE_SSL=false
EMAIL_SMTP_USERNAME=local-user
EMAIL_SMTP_PASSWORD=local-password
EMAIL_SMTP_SENDER_ADDRESS=no-reply@streetcode.test
EMAIL_FEEDBACK_RECIPIENT_ADDRESS=feedback@streetcode.test

IDENTITY_DB_NAME=StreetcodeIdentityDb
IDENTITY_API_PORT=5001
GATEWAY_PORT=5002

KAFKA_PORT=9092
KAFKA_USER_ACCESS_CHANGED_TOPIC=identity.user-access-changed.v1

# Identity initial data seeding
IDENTITY_SEED_ENABLED=false
IDENTITY_ADMIN_EMAIL=
IDENTITY_ADMIN_PASSWORD=
BLOB_PROVIDER=Azure
BLOB_CONTAINER_NAME=streetcode-blobs

# Redis (used by API inside/outside Docker)
STREETCODE_ConnectionStrings__Redis=localhost:6379
