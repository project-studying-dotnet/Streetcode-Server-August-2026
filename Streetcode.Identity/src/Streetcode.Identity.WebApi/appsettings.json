{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "Topics": {
      "UserAccessChangedV1": "identity.user-access-changed.v1"
    },
    "OutboxBatchSize": 50,
    "OutboxPollingInterval": "00:00:05"
  },
  "RefreshTokens": {
    "Lifetime": "30.00:00:00"
  },
  "AllowedHosts": "*"
}
